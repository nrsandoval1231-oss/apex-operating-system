---
/**
 * LegalDocument.astro — renders a transcribed legal document as readable prose.
 *
 * Deliberately plain. Legal pages are read, not marketed at: one column, a comfortable
 * measure, generous leading, and no decoration competing with the text. The only brand
 * present is the header, footer, and the sage rule under the title.
 */
import type { LegalBlock, LegalDocument } from '@content/legal';

interface Props {
  doc: LegalDocument;
}
const { doc } = Astro.props;

const escapeHtml = (s: string) =>
  s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');

/**
 * Render a transcribed paragraph. Everything is escaped first, so the only markup that can
 * reach the page is what this function adds: <br> for the newlines inside a transcribed
 * address block, and one optional anchor around a phrase that already exists in the text.
 * The wording is never changed — see the note on `linkPhrase` in content/legal.ts.
 */
function renderBlock(block: LegalBlock): string {
  let html = escapeHtml(block.text ?? '').replace(/\n/g, '<br />');
  const { linkPhrase, linkHref } = block;
  if (linkPhrase && linkHref) {
    const escaped = escapeHtml(linkPhrase);
    if (!html.includes(escaped)) {
      // Fail loudly: a silent miss would drop a required cross-reference link.
      throw new Error(`Legal linkPhrase not found in text: ${JSON.stringify(linkPhrase)}`);
    }
    html = html.replace(escaped, `<a href="${linkHref}">${escaped}</a>`);
  }
  return html;
}
---
<section class="legal">
  <div class="wrap">
    <p class="eyebrow">Legal</p>
    <h1>{doc.title}</h1>
    {/* The rule lives on its own element so it appears whether or not the document
        carries an effective date — the terms don't. */}
    <div class="title-rule">
      {doc.effective && <p class="effective mono">{doc.effective}</p>}
    </div>

    <div class="legal-body">
      {doc.sections.map((section) => (
        <>
          {section.heading && <h2>{section.heading}</h2>}
          {section.blocks.map((block) =>
            block.type === 'ul' ? (
              <ul>{block.items?.map((item) => <li>{item}</li>)}</ul>
            ) : (
              <p set:html={renderBlock(block)} />
            ),
          )}
        </>
      ))}
    </div>
  </div>
</section>

<style>
  .legal {
    background: var(--paper);
    padding: 64px 0 88px;
  }
  .legal .wrap {
    max-width: 780px;
  }
  .legal h1 {
    font-size: clamp(34px, 5vw, 52px);
    margin-top: 10px;
  }
  .title-rule {
    margin-top: 14px;
    padding-bottom: 22px;
    border-bottom: 3px solid var(--sage);
  }
  .effective {
    font-size: 12px;
    letter-spacing: 0.06em;
    color: var(--steel);
    margin: 0;
  }
  .legal-body {
    margin-top: 34px;
  }
  .legal-body h2 {
    font-size: 22px;
    margin: 40px 0 14px;
    color: var(--char);
  }
  .legal-body p {
    color: var(--steel);
    line-height: 1.75;
    margin: 0 0 16px;
  }
  .legal-body ul {
    margin: 0 0 20px;
    padding-left: 22px;
    color: var(--steel);
    line-height: 1.75;
  }
  .legal-body li {
    margin-bottom: 8px;
  }
  .legal-body :global(a) {
    color: var(--sage-ink);
    border-bottom: 1px solid var(--sage-ink);
  }
</style>
