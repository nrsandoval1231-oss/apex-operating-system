---
/**
 * GuaranteeBand.astro — dark stat band between the vertical sections and testimonials.
 * Stats from content/site-copy.ts.
 */
import { guaranteeStats } from '@content/site-copy';
---
<div class="band-g">
  <ul class="wrap gwrap">
    {guaranteeStats.map((stat) => (
      <li class="g"><b>{stat.value}</b><span>{stat.label}</span></li>
    ))}
  </ul>
</div>
