# Generated dependencies and outputs
**/node_modules/

# This is a pnpm workspace (pnpm-workspace.yaml, pnpm-lock.yaml). An npm install
# run here replaces the workspace symlinks with stale copies, so a newly added
# file in packages/* becomes invisible to tsc and to every other package until
# `pnpm install` repairs it. Ignoring the lockfile keeps that mistake local
# instead of committing it for everyone.
/package-lock.json
**/package-lock.json
# Designer is an npm app inside the workspace. The image build copies this
# lockfile and runs `npm ci` (see Dockerfile). Keep it tracked.
!apps/designer/package-lock.json
/yarn.lock
**/yarn.lock
**/dist/
**/build/
**/coverage/
**/.astro/
**/.vite/
**/.cache/
**/__pycache__/
**/.venv/
**/venv/
*.log

# Secrets
**/.env
**/.env.*
!**/.env.example

# OS/editor artifacts
.DS_Store
Thumbs.db
*.tmp
~$*

# Scratch and staged-for-deletion areas (never committed)
/tmp/
/_to_delete/

# Hermes transient attachments (plans are intentional project records)
.hermes/desktop-attachments/

# Retired sibling-checkout names. Canonical copies live under apps/, workflows/,
# docs/prd, archive/, and tools/. Do not reintroduce those directories at the
# repository root (they are not submodules). `Apex Designer` is the historical
# checkout directory (space, capitals); `apex-designer` is the old repo name.
/Apex Designer/
/apex-designer/
/apex-decks/
/apex-lead-engine/
/apex-prds/
/apex-proposal-engine/
/apex-website/

# Local pilot database and evidence (never committed)
/var/
