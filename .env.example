# Apex Website — environment variables
# Copy to `.env` and fill. NEVER commit `.env`.
# Vars prefixed PUBLIC_ are exposed to the browser by Astro — put nothing secret in them.

# ---- Lead capture (required) ----
# Where the quote form POSTs. Provided by the apex-lead-engine n8n instance.
# See D-21: use the real Phase 1 intake endpoint, or an explicit test endpoint. Do not stub silently.
PUBLIC_LEAD_WEBHOOK_URL=https://n8n.example.hstgr.cloud/webhook/apex-lead-intake

# Separate endpoint for non-production builds. Hard rule 6: preview/test never posts to production.
PUBLIC_LEAD_WEBHOOK_URL_TEST=https://n8n.example.hstgr.cloud/webhook-test/apex-lead-intake

# ---- Site config (required) ----
# Canonical domain — BLOCKED on D-03. Used for sitemap, canonical tags, OG URLs.
PUBLIC_SITE_URL=https://apexgetsitdone.com

# Environment gate. "production" enables the live webhook; anything else uses the test one.
PUBLIC_ENV=development

# Social share image (og:image / twitter:image), site-relative, 1200x630.
# BLOCKED on D-20 — leave blank until real photography exists. Blank omits the image tags
# entirely rather than shipping a placeholder that social scrapers will cache.
PUBLIC_OG_IMAGE=

# ---- Analytics (required for AC-5.5) ----
# Tags load ONLY when PUBLIC_ENV=production, or when PUBLIC_ANALYTICS_FORCE=true below.
# Existing container on the current site. Confirm access transfer first — see D-01.
PUBLIC_GTM_ID=GTM-WSHKQ3X
# Direct GA4 is used ONLY when no GTM container is set — never both (double-counting).
PUBLIC_GA4_MEASUREMENT_ID=

# Explicit override to load tags from a NON-production build, so AC-5.5 can be verified on
# staging. Leave false everywhere else — a shared preview with this on pollutes the real
# GA4 property (Hard rule 6).
PUBLIC_ANALYTICS_FORCE=false

# ---- Meta (optional at build time) ----
# Browser pixel only. Server-side Conversions API lives in apex-lead-engine, not here.
PUBLIC_META_PIXEL_ID=

# ---- Contact (required — rendered in header, footer, CTAs) ----
PUBLIC_PHONE_DISPLAY=806.605.0502
PUBLIC_PHONE_E164=+18066050502
PUBLIC_CONTACT_EMAIL=travis@apexgetsitdone.com

# ---- Per-vertical tracking numbers (optional; enables call attribution) ----
# Leave blank to fall back to PUBLIC_PHONE_DISPLAY everywhere.
# Populating these is what makes inbound calls attributable by vertical.
PUBLIC_PHONE_POOLS=
PUBLIC_PHONE_COATING=
PUBLIC_PHONE_RENOVATION=
PUBLIC_PHONE_SERVICE=

# ---- CMS (only if D-07 resolves to self-serve editing) ----
# Leave blank while content lives in `content/` as Markdown/MDX.
CMS_PROJECT_ID=
CMS_API_TOKEN=
