# Anything the build produces itself, or must never enter an image.
**/node_modules
**/dist
**/.vite
**/coverage
.git
.github
var
_to_delete

# Preserved component repositories that are not production dependencies.
# Apex Designer is intentionally included: Apex OS embeds its pinned submodule.
apex-decks
apex-lead-engine
apex-prds
apex-proposal-engine
apex-website

# Secrets must arrive as environment variables, never baked into a layer.
**/.env
**/.env.*
!**/.env.example

# Foreign lockfiles: an npm install here breaks the pnpm workspace links.
package-lock.json
!Apex Designer/package-lock.json
yarn.lock
