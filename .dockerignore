# Anything the build produces itself, or must never enter an image.
**/node_modules
**/dist
**/.vite
**/coverage
.git
.github
var
_to_delete

# Retired sibling-checkout directory names, anchored to the build context root.
# `Apex Designer` (space) is the historical CI checkout. Live Designer source
# is apps/designer and is not excluded.
/Apex Designer
/apex-designer
/apex-decks
/apex-lead-engine
/apex-prds
/apex-proposal-engine
/apex-website

# Secrets must arrive as environment variables, never baked into a layer.
**/.env
**/.env.*
!**/.env.example

# Foreign lockfiles: an npm install at the workspace root breaks pnpm links.
# The exception is the Designer lockfile the Dockerfile copies for `npm ci`.
package-lock.json
!apps/designer/package-lock.json
yarn.lock
