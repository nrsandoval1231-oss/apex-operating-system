{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Apex Designer",
  "version": "0.1.0",
  "identifier": "com.apexdesignerpools.designer",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Apex Designer",
        "width": 1440,
        "height": 960,
        "minWidth": 1100,
        "minHeight": 700,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "publisher": "Apex Designer Pools",
    "copyright": "Apex Designer Pools",
    "shortDescription": "Pool and spa plan and materials takeoff",
    "longDescription": "Draws the plan and the longitudinal section, and computes the materials takeoff. Quantities only — not a permit set and not a stamped engineering document.",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["English"]
      }
    }
  }
}
