# Apex Website — environment variables
# Copy to `.env` and fill. NEVER commit `.env`.
# Vars prefixed PUBLIC_ are exposed to the browser by Astro — put nothing secret in them.

# ---- Lead capture (required for a production build) ----
# Where the quote form POSTs. The browser calls this URL, so it is public once shipped.
# It is not hardcoded in src/lib/site.ts. Astro inlines PUBLIC_ vars at build time, and a
# static host cannot inject them after upload — set them in the environment of the build
# that produces dist/ (shell, CI, or the host's build settings).
# Set the real intake URL in the build environment. Do not commit a live host.
# A production build with PUBLIC_LEAD_WEBHOOK_URL unset fails closed.
# The value below is a documentation example only (example TLD, not an Apex host).
PUBLIC_LEAD_WEBHOOK_URL=https://lead-webhook.example/webhook/apex-lead-intake

# Separate endpoint for non-production builds. Hard rule 6: preview/test never posts to production.
# site.ts does not invent a host when this is unset.
PUBLIC_LEAD_WEBHOOK_URL_TEST=https://lead-webhook.example/webhook-test/apex-lead-intake

# ---- Site config (required) ----
# Canonical domain — BLOCKED on D-03. Used for sitemap, canonical tags, OG URLs.
PUBLIC_SITE_URL=https://apexgetsitdone.com

# Environment gate. "production" enables the live webhook; anything else uses the test one.
PUBLIC_ENV=development

# Social share image (og:image / twitter:image), site-relative, 1200x630.
# BLOCKED on D-20 — leave blank until real photography exists. Blank omits the image tags
# entirely rather than shipping a placeholder that social scrapers will cache.
PUBLIC_OG_IMAGE=

# ---- Analytics (required for AC-5.5) ----
# Tags load ONLY when PUBLIC_ENV=production, or when PUBLIC_ANALYTICS_FORCE=true below.
# Existing container on the current site. Confirm access transfer first — see D-01.
PUBLIC_GTM_ID=GTM-WSHKQ3X
# Direct GA4 is used ONLY when no GTM container is set — never both (double-counting).
PUBLIC_GA4_MEASUREMENT_ID=

# Explicit override to load tags from a NON-production build, so AC-5.5 can be verified on
# staging. Leave false everywhere else — a shared preview with this on pollutes the real
# GA4 property (Hard rule 6).
PUBLIC_ANALYTICS_FORCE=false

# ---- Meta (optional at build time) ----
# Browser pixel only. Server-side Conversions API lives in apex-lead-engine, not here.
PUBLIC_META_PIXEL_ID=

# ---- Contact (required — rendered in header, footer, CTAs) ----
PUBLIC_PHONE_DISPLAY=806.605.0502
PUBLIC_PHONE_E164=+18066050502
PUBLIC_CONTACT_EMAIL=travis@apexgetsitdone.com

# ---- Financing partner (required before launch) ----
# Rendered as a real link under the pools CTA and in the footer. Financing is the objection
# that stops a six-figure pool quote, and until now it was dead text.
# Use Apex's PARTNER/referral URL from Lyon if one exists — the default below is the public
# marketing site and attributes the referral to nobody.
PUBLIC_FINANCING_URL=https://www.lyonfinancial.net/

# ---- Legal pages (required before launch) ----
# Rendered as real links in the footer. The privacy policy MUST be reachable and must name
# SMS: carriers check it during A2P 10DLC registration, and it is the TCPA backstop for the
# per-vertical consent line. Defaults point at where the policies live today.
# See D-03 — if apexcoatinglbk.com gets wildcard-redirected at cutover, these break.
# Both are now internal routes (/privacy, /terms) holding text transcribed verbatim from the
# live site. Override only if counsel wants the canonical copies hosted elsewhere.
PUBLIC_PRIVACY_URL=/privacy
PUBLIC_TERMS_URL=/terms

# ---- Per-vertical tracking numbers (optional; enables call attribution) ----
# Leave blank to fall back to PUBLIC_PHONE_DISPLAY everywhere.
# Populating these is what makes inbound calls attributable by vertical.
PUBLIC_PHONE_POOLS=
PUBLIC_PHONE_COATING=
PUBLIC_PHONE_RENOVATION=
PUBLIC_PHONE_SERVICE=

# ---- CMS (only if D-07 resolves to self-serve editing) ----
# Leave blank while content lives in `content/` as Markdown/MDX.
CMS_PROJECT_ID=
CMS_API_TOKEN=
