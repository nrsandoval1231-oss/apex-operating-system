---
/**
 * Hero.astro — the hero + the four-vertical router (the site's primary job).
 *
 * Tiles are generated from VERTICAL_LIST (enum order — AC-2.1), each colour-coded to its
 * token (VERTICAL_CONFIG.accentVar) and carrying content from ROUTER_TILES. The vertical
 * name is rendered as the exact enum string (AC-2.4). Each tile carries `data-preselect`
 * with the exact vertical so Phase 3 can pre-select it in the quote form (AC-2.2).
 *
 * Phase 4: a tile now links to that vertical's LANDING PAGE (`/${cfg.slug}`) instead of an
 * in-page anchor. The destination is derived from the slug in verticals.ts, never stored
 * alongside the tile copy — one list of URLs, so a tile cannot drift onto the wrong vertical.
 * The tile still sets the preselect, so a visitor who lands on /pools finds the form ready.
 */
import { hero } from '@content/site-copy';
import { VERTICAL_LIST } from '@content/verticals';
import { ROUTER_TILES } from '@content/router-tiles';
import ImageSlot from './ImageSlot.astro';
import HeroVideo from './HeroVideo.astro';
---
<section class="hero" id="top" style="padding:0">
  <HeroVideo />
  <div class="hero-media-shade" aria-hidden="true"></div>
  <svg class="grain" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
    <filter id="heroNoise">
      <feTurbulence type="fractalNoise" baseFrequency="0.9" numOctaves="2" stitchTiles="stitch" />
    </filter>
    <rect width="100%" height="100%" filter="url(#heroNoise)" />
  </svg>
  <div class="wrap hero-in">
    <p class="eyebrow anim">{hero.eyebrow}</p>
    <h1 class="anim a2" style="margin-top:14px">
      {hero.headingLines.map((line) => (<>{line}<br /></>))}
      <span class="accent">{hero.headingAccent}</span>
    </h1>
    <p class="hero-sub anim a3">{hero.sub}</p>

    <div class="hero-stats anim a4">
      {hero.stats.map((s) => (
        <div class="hstat"><b>{s.value}</b><span>{s.label}</span></div>
      ))}
    </div>

    <div class="router anim a4">
      <h2 class="router-q disp">{hero.routerQuestion}</h2>
      <ul class="tiles">
        {VERTICAL_LIST.map((cfg) => {
          const tile = ROUTER_TILES[cfg.vertical];
          return (
            <li>
              <a
                class="tile"
                href={`/${cfg.slug}`}
                style={`--tint:var(${cfg.accentVar})`}
                data-preselect={cfg.vertical}
              >
                <span class="band"></span>
                {/*
                  Lazy, despite these being the site's primary conversion element. The tiles
                  sit BELOW the fold at every viewport we target — the hero copy, subhead, and
                  stat strip come first — so eager-loading four images here made them compete
                  with the hero for bandwidth and pushed out LCP (AC-5.1). Caught by the AC-9.5
                  test. In practice Chrome begins fetching a lazy image well before it enters
                  the viewport, so there is no pop-in on scroll.
                */}
                <ImageSlot id={tile.image} sizes="(max-width:860px) 50vw, 25vw" />
                <h3>{cfg.vertical}</h3>
                <div class="sub">{tile.subtitle}</div>
                <div class="go">{tile.cta} &rarr;</div>
              </a>
            </li>
          );
        })}
      </ul>
    </div>
  </div>
</section>
