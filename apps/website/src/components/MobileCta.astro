---
import { site } from '@lib/site';
const { path } = Astro.props as { path: string };
const legal = ['/privacy','/terms','/legacy-privacy'].includes(path);
---
{!legal && <nav class="mobile-cta" aria-label="Quick contact"><a href={`tel:${site.phoneE164}`}>Call {site.phoneDisplay}</a><a href="#quote">Get a free quote</a></nav>}
<style is:global>
  .mobile-cta{display:none}
  @media(max-width:760px){.mobile-cta{display:grid;grid-template-columns:1fr 1.2fr;position:fixed;z-index:60;bottom:0;left:0;right:0;padding:8px 12px calc(8px + env(safe-area-inset-bottom));background:#383838;gap:9px}.mobile-cta a{text-align:center;padding:12px 6px;color:#fff;border:1px solid #A1CCCA;font:16px 'Bebas Neue',sans-serif;text-transform:uppercase}.mobile-cta a:last-child{background:#A1CCCA;color:#222}body:has(.mobile-cta){padding-bottom:calc(64px + env(safe-area-inset-bottom))}body:has(#quote :focus) .mobile-cta{display:none}}
</style>
