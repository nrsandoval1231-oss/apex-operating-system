---
import source from '@content/legal-current.json';
const { kind } = Astro.props as { kind: 'privacy' | 'terms' };
const raw = source[kind];
const start = raw.search(/^# /m);
const text = raw.slice(start);
const lines = text.split(/\r?\n/);
const blocks = lines.reduce((out: Array<{type:string,text?:string,items?:string[]}>, line) => {
  if (!line.trim() || /^\s*!\[/.test(line) || /data:image\//i.test(line) || /Your Content Goes Here/i.test(line)) return out;
  if (/^#{1,3} /.test(line)) out.push({type:'heading',text:line.replace(/^#+\s*/, '')});
  else if (/^\*\*[^*]+\*\*$/.test(line.trim())) out.push({type:'heading',text:line.trim().replace(/^\*\*|\*\*$/g,'')});
  else if (/^[-*] /.test(line)) { const last=out[out.length-1]; if(last?.type==='list') last.items?.push(line.replace(/^[-*] /,'')); else out.push({type:'list',items:[line.replace(/^[-*] /,'')]}); }
  else out.push({type:'paragraph',text:line});
  return out;
}, []);
const inline = (value: string) => value.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/\*\*([^*]+)\*\*/g,'<strong>$1</strong>').replace(/\[([^\]]+)\]\((https?:\/\/[^ )]+|mailto:[^ )]+|tel:[^ )]+)\)/g,'<a href="$2" rel="noopener">$1</a>');
---
<section class="legal"><div class="wrap"><p class="eyebrow">Apex · Lubbock, Texas</p><h1>{kind === 'privacy' ? 'Privacy Policy' : 'Terms and Conditions'}</h1><div class="legal-body">{blocks.map((b) => b.type==='heading' ? <h2>{b.text}</h2> : b.type==='list' ? <ul>{b.items?.map(i=><li set:html={inline(i)} />)}</ul> : <p set:html={inline(b.text ?? '')} />)}</div></div></section>
<style>.legal{padding:64px 0 88px;background:var(--paper)}.legal .wrap{max-width:780px}.legal h1{font-size:clamp(34px,5vw,52px)}.legal-body{line-height:1.7;overflow-wrap:anywhere;word-break:normal}.legal-body h2{margin-top:30px}.legal-body>*{max-width:100%;min-width:0}</style>

