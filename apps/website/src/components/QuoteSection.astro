---
/**
 * QuoteSection.astro — Phase 3. The #quote section: heading/lead from content, the two-column
 * grid (form + capture panel), and the QuoteForm React island (client:visible — only this part
 * ships JS). The inline script wires every [data-preselect] CTA to the island so clicking e.g.
 * "Start my pool quote" pre-selects Designer Pools (AC-2.2), while the selector stays changeable.
 *
 * Webhook + contact come from site config (env). Hard rule 6 / AC-1.7: leadWebhookUrl resolves
 * to the TEST endpoint unless PUBLIC_ENV=production.
 *
 * Phase 4: `preselect` lets a vertical landing page open with its own vertical already chosen
 * (AC-2.2) without requiring a click. It is set BEFORE the island hydrates, which is why it is
 * an `is:inline` script in markup order rather than a component prop — the island reads
 * window.__apexPreselect on mount. The user can still change the selection (AC-2.3).
 */
import { sections } from '@content/site-copy';
import { site, leadWebhookUrl } from '@lib/site';
import { isVertical, type Vertical } from '@content/verticals';
import QuoteForm from './QuoteForm.tsx';

interface Props {
  /** Vertical to pre-select on page load. Omit on the home page (no vertical implied yet). */
  preselect?: Vertical;
  /** Override the section heading — vertical pages ask a narrower question. */
  heading?: string;
  lead?: string;
}

const { preselect, heading, lead } = Astro.props;

// Fail loud rather than silently mis-tagging a lead: an invalid preselect would ship a form
// whose vertical doesn't match the page it's on (Hard rule 1 / AC-2.4).
if (preselect !== undefined && !isVertical(preselect)) {
  throw new Error(`QuoteSection preselect is not a valid vertical: ${JSON.stringify(preselect)}`);
}
---
{preselect && (
  <script is:inline define:vars={{ preselect }}>
    window.__apexPreselect = preselect;
  </script>
)}
<section id="quote">
  <span id="contact" class="anchor-alias" aria-hidden="true"></span>
  <div class="wrap">
    {site.env !== 'production' && <p class="preview-notice" role="note">Website preview — use test details only.</p>}
    <div class="sec-head">
      <p class="eyebrow">{sections.quote.eyebrow}</p>
      <h2>{heading ?? sections.quote.heading}</h2>
      <p class="lead">{lead ?? sections.quote.lead}</p>
    </div>

    <div class="qgrid">
      <QuoteForm
        client:visible
        initialVertical={preselect}
        webhookUrl={leadWebhookUrl}
        phoneDisplay={site.phoneDisplay}
        phoneE164={site.phoneE164}
      />
      <aside class="quote-help">
        <p class="eyebrow">Prefer a conversation?</p>
        <h3>Call our Lubbock team.</h3>
        <p>Talk through your project directly with Apex.</p>
        <a class="btn ghost" href={`tel:${site.phoneE164}`}>{site.phoneDisplay}</a>
        <p class="quote-help-note">Apex serves customers in Lubbock, Texas.</p>
      </aside>
    </div>
  </div>
</section>

<script>
  // Wire vertical CTAs to the quote-form island. Set a global for the initial mount race, and
  // dispatch an event for when the island is already mounted. (AC-2.2)
  const setPreselect = (v: string) => {
    (window as unknown as { __apexPreselect?: string }).__apexPreselect = v;
    window.dispatchEvent(new CustomEvent('apex:preselect', { detail: v }));
  };
  document.querySelectorAll('[data-preselect]').forEach((el) => {
    el.addEventListener('click', () => {
      const v = el.getAttribute('data-preselect');
      if (v) setPreselect(v);
    });
  });
</script>
<style>
  .anchor-alias{display:block;position:relative;top:-72px;visibility:hidden}
  .preview-notice{padding:10px 14px;background:#65BC7B;color:#202820;font-weight:700;border-radius:4px}
  .quote-help{padding:38px 26px;border-top:1px solid #626565;align-self:start}.quote-help h3{font-size:34px;color:white;margin:12px 0}.quote-help p{color:#e3e3e3}.quote-help .eyebrow{color:#A1CCCA}.quote-help .btn.ghost{background:#383838;color:#fff;border-color:#383838}.quote-help-note{margin-top:34px;font-size:14px}
  @media(max-width:900px){.quote-help{padding:22px 0}}
</style>
