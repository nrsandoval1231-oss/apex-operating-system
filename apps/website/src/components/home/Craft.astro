---
/**
 * Craft.astro — Section 02 of 07. CRAFTSMANSHIP.
 *
 * The "splash / underwater transition" beat from the vision doc, expressed as a composition
 * rather than an effect. Once the brand film exists this section is where the splash lands, so
 * the two detail images are framed as a surface world and a submerged world — the split is
 * doing narrative work, not decorating.
 *
 * The four detail notes are a typographic list on a hairline, NOT an icon grid. The brief rules
 * that out explicitly, and an icon per material would make four construction features look like
 * four SaaS features.
 */
import { craftV2 } from '@content/home-v2';
import ImageSlot from '@components/ImageSlot.astro';
---
<section class="craft" id="craft">
  <div class="wrap">
    <header class="sec-head">
      <p class="eyebrow">{craftV2.eyebrow}</p>
      <h2 class="sec-title">
        <span>{craftV2.headingLines[0]}</span>
        <span class="accent">{craftV2.headingLines[1]}</span>
      </h2>
      <p class="lead">{craftV2.lead}</p>
    </header>

    <div class="craft-grid">
      <figure class="craft-fig craft-fig--tall">
        <ImageSlot id="v2-craft-detail" sizes="(max-width:900px) 100vw, 46vw" />
        <figcaption class="mono">The waterline — where finish meets water</figcaption>
      </figure>

      <div class="craft-side">
        <figure class="craft-fig craft-fig--wide">
          <ImageSlot id="v2-craft-wide" sizes="(max-width:900px) 100vw, 40vw" />
        </figure>

        {/*
          A definition list, not a list of cards. `dl` because each entry genuinely is a term
          with an explanation, and it reads correctly to a screen reader — a `ul` of four styled
          divs here would announce four disconnected strings.
        */}
        <dl class="craft-list">
          {
            craftV2.details.map((d) => (
              <div class="craft-row">
                <dt>{d.label}</dt>
                <dd>{d.note}</dd>
              </div>
            ))
          }
        </dl>
      </div>
    </div>
  </div>
</section>

<style>
  .craft { background: var(--paper); }

  .sec-title { display: flex; flex-direction: column; }
  .sec-title .accent { color: var(--sage-ink); }

  .craft-grid {
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    gap: clamp(24px, 4vw, 56px);
    margin-top: clamp(34px, 5vw, 64px);
    align-items: start;
  }
  @media (max-width: 900px) {
    .craft-grid { grid-template-columns: 1fr; }
  }

  .craft-fig { margin: 0; }
  .craft-fig figcaption {
    margin-top: 12px;
    font-size: 10.5px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--steel);
  }

  .craft-side { display: flex; flex-direction: column; gap: clamp(20px, 3vw, 32px); }

  /*
    Zero border-radius on the imagery. The global system uses --r (14px) on .img-slot, which is
    right for cards and tiles and wrong here: rounded corners on full-bleed editorial photography
    are the single clearest "website template" signal, and this page is specifically not one.
    Overridden per-section rather than globally, because the vertical pages still want it.
  */
  .craft-fig :global(.img-slot) { border-radius: 0; border: 0; }

  .craft-list { margin: 0; }
  .craft-row {
    display: grid;
    grid-template-columns: 150px 1fr;
    gap: 4px 20px;
    padding: 18px 0;
    border-top: 1px solid var(--line);
  }
  .craft-row:last-child { border-bottom: 1px solid var(--line); }

  .craft-row dt {
    font-family: Oswald, sans-serif;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    font-size: 16px;
    line-height: 1.3;
  }
  .craft-row dd { margin: 0; color: var(--steel); font-size: 15.5px; line-height: 1.55; }

  @media (max-width: 560px) {
    /* Stacked term/definition on a phone. Keeping the 150px column would leave ~150px for the
       definition at 390px wide, which is a four-word-per-line rag. */
    .craft-row { grid-template-columns: 1fr; gap: 4px; }
  }
</style>
