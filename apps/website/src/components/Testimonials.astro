---
/**
 * Testimonials.astro — customer proof. Content from content/testimonials.ts.
 */
import { sections } from '@content/site-copy';
import { testimonials } from '@content/testimonials';
---
<section id="proof">
  <div class="wrap">
    <div class="sec-head">
      <p class="eyebrow">{sections.proof.eyebrow}</p>
      <h2>{sections.proof.heading}</h2>
    </div>
    <div class="quotes">
      {testimonials.map((t) => (
        <figure class="q">
          <div class="stars" aria-label={`${t.stars} out of 5 stars`}>{'★'.repeat(t.stars)}</div>
          <blockquote><p>{t.quote}</p></blockquote>
          <figcaption class="who">{t.name}<span>{t.context}</span></figcaption>
        </figure>
      ))}
    </div>
  </div>
</section>
