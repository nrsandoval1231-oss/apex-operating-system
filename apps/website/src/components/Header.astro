---
/**
 * Header.astro — sticky nav: brand, phone (from env), and a Get a Quote CTA.
 * Contact details come from site config (env), never hardcoded.
 *
 * Phase 4: the brand links to `/`, not `#top` — the site is multi-page now, and on a vertical
 * landing page the logo must take you home. `#quote` stays an anchor because every page,
 * including each vertical page, renders its own quote section.
 */
import { site } from '@lib/site';
import Logo from './Logo.astro';
---
<header>
  <div class="wrap nav">
    {/*
      The real lockup already contains both the lion and the APEX wordmark, so the previously
      hand-set "APEX / GETS IT DONE" text block is gone — rendering it alongside the logo would
      print the brand name twice. The link carries the accessible name and the image is marked
      decorative, so the destination is announced once.
    */}
    <a class="brand" href="/" aria-label="Apex — Gets It Done, home">
      <Logo height={40} alt={null} />
    </a>
    <div class="nav-r">
      <a class="nav-phone" href={`tel:${site.phoneE164}`}>{site.phoneDisplay}</a>
      <a class="btn ghost nav-phone-sm" href={`tel:${site.phoneE164}`}>Call</a>
      <a class="btn" href="#quote">Get a Quote</a>
    </div>
  </div>
</header>
