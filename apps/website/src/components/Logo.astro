---
/**
 * Logo.astro — the real Apex logo lockup.
 *
 * Supplied by the maintainer as `Apex-Site-Logo-2x.png` and used verbatim. `CLAUDE.md`:
 * "If the maintainer supplies the real brand hexes or logo file, those override." This
 * replaces the placeholder starburst lion that was ported from the pitch mockup — that mark
 * was an approximation and was never Apex's actual identity.
 *
 * The lockup is self-contained: a solid sage (#A1CCCA) panel carrying the charcoal-and-white
 * lion, a transparent divider, and the boxed APEX wordmark. Because it brings its own
 * background it sits on the charcoal header as a badge, which is how it is drawn — do NOT
 * try to knock the sage out or recolour it.
 *
 * It also already contains the word "APEX", so nothing here re-renders that as text; doing so
 * would say the brand name twice. The "GETS IT DONE" tagline is not part of the lockup and is
 * kept as separate copy where there is room for it (the footer).
 *
 * Intrinsic size is 801×191 (a 2x asset), so at header scale it is well over 2x — crisp on
 * any display. width/height are declared to reserve space and avoid layout shift.
 *
 * TODO: request an SVG or EPS from whoever made this. A vector logo scales without ceiling
 * and would drop ~10 KB. The PNG is correct, just not ideal at very large sizes.
 */
interface Props {
  /** Rendered height in px. Width follows the 801:191 ratio. */
  height?: number;
  class?: string;
  /**
   * Accessible name. Pass null when an ancestor link already names the destination —
   * otherwise a screen reader announces the brand twice.
   */
  alt?: string | null;
  loading?: 'lazy' | 'eager';
}

const { height = 40, class: className, alt = 'Apex — Gets It Done', loading = 'eager' } = Astro.props;

const RATIO = 801 / 191;
const width = Math.round(height * RATIO);
const classes = ['apex-logo', className].filter(Boolean).join(' ');
---
<img
  src="/images/brand/apex-logo.png"
  alt={alt ?? ''}
  width={width}
  height={height}
  class={classes}
  loading={loading}
  decoding="async"
  style={`height:${height}px;width:${width}px`}
/>

<style>
  .apex-logo {
    display: block;
    flex: none;
    /* The asset is raster; keep the edges clean when it lands on a fractional pixel. */
    image-rendering: auto;
  }
</style>
