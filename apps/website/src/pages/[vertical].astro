---
/**
 * [vertical].astro — the four vertical landing pages: /pools, /coating, /renovation, /service.
 *
 * ONE template, four routes, generated from VERTICAL_LIST. This is deliberate: a hand-written
 * page per vertical is four places for the enum strings to drift (AC-2.4) and four places to
 * forget the attribution wiring. getStaticPaths over the single source of truth means adding a
 * fifth vertical to verticals.ts produces its page, its sitemap entry, and its schema for free —
 * and makes it impossible to ship a vertical with no landing page.
 *
 * Each page delivers:
 *  - a unique <title>, description, canonical, and OG set (AC-5.2)
 *  - exactly one <h1>, in VerticalHero (AC-5.3)
 *  - the service list for that vertical, reused from the existing content files
 *  - a visible FAQ, mirrored exactly by FAQPage JSON-LD
 *  - the quote form with the vertical PRE-SELECTED (AC-2.2) and still changeable (AC-2.3)
 *
 * The landing_page attribution for a visitor who arrives here is captured by BaseLayout's
 * first-touch script — that is what AC-1.5 asserts against `/pools`.
 */
import BaseLayout from '@layouts/BaseLayout.astro';
import Header from '@components/Header.astro';
import VerticalHero from '@components/VerticalHero.astro';
import Faq from '@components/Faq.astro';
import GuaranteeBand from '@components/GuaranteeBand.astro';
import Testimonials from '@components/Testimonials.astro';
import QuoteSection from '@components/QuoteSection.astro';
import Footer from '@components/Footer.astro';
import ImageSlot from '@components/ImageSlot.astro';

import { VERTICAL_LIST, type VerticalConfig } from '@content/verticals';
import { getVerticalPage, type VerticalPage } from '@content/vertical-pages';
import { pools } from '@content/pools';
import { serviceCards } from '@content/service-cards';
import {
  breadcrumbSchema,
  faqSchema,
  jsonLdGraph,
  serviceSchema,
  SERVICE_AREA,
} from '@lib/seo';

export function getStaticPaths() {
  return VERTICAL_LIST.map((cfg) => ({
    // The route param IS the slug from verticals.ts — no second list of URLs to keep in sync.
    params: { vertical: cfg.slug },
    props: { cfg, page: getVerticalPage(cfg.vertical) },
  }));
}

interface Props {
  cfg: VerticalConfig;
  page: VerticalPage;
}

const { cfg, page } = Astro.props;
const path = `/${cfg.slug}`;

/**
 * The "what we do" list. Reused from the content the mockup already approved (D-08) rather
 * than rewritten: pools.ts for Designer Pools, service-cards.ts for the other three. If a
 * vertical ever has neither, that's a content gap and should fail the build, not render empty.
 */
const card = serviceCards.find((c) => c.vertical === cfg.vertical);
const features =
  cfg.vertical === pools.vertical ? pools.features : card?.services;
if (!features || features.length === 0) {
  throw new Error(`No service list found for vertical: ${cfg.vertical}`);
}

// The serv accent is too light for small text on white (AC-6.4) — same rule as MoreVerticals.
const textAccent = cfg.accentVar === '--serv' ? '--serv-text' : cfg.accentVar;

const jsonLd = jsonLdGraph([
  serviceSchema(cfg.vertical, page.seoDescription, path),
  faqSchema(page.faq, path),
  breadcrumbSchema(cfg.vertical, path),
]);
---
<BaseLayout
  title={page.seoTitle}
  description={page.seoDescription}
  path={path}
  jsonLd={jsonLd}
>
  <Header />
  <main>
    <VerticalHero page={page} accentVar={cfg.accentVar} />

    <section class="vservices">
      <div class="wrap">
        <div class:list={['vservices-body', { 'has-photo': Boolean(page.secondaryImage) }]}>
          <div>
            <div class="sec-head">
              <p class="eyebrow" style={`color:var(${textAccent})`}>What we do</p>
              <h2>{card ? card.heading : pools.heading}</h2>
            </div>
            <ul class="featlist" style={`--vt:var(${cfg.accentVar})`}>
              {features.map((f) => <li>{f}</li>)}
            </ul>

            <p class="area mono">
              Serving {SERVICE_AREA.slice(0, -1).join(' · ')} and the wider South Plains.
            </p>
          </div>
          {page.secondaryImage && (
            <ImageSlot
              id={page.secondaryImage}
              class="vservices-photo"
              sizes="(max-width:900px) 100vw, 40vw"
            />
          )}
        </div>
      </div>
    </section>

    <GuaranteeBand />
    <Faq items={page.faq} accentVar={cfg.accentVar} />
    <Testimonials />
    <QuoteSection
      preselect={cfg.vertical}
      heading={`Get your ${cfg.vertical.toLowerCase()} quote.`}
      lead={`Your service is already selected — add your details and we'll text you back in minutes, not days. Routed straight to the ${cfg.vertical} crew.`}
    />
  </main>
  <Footer />
</BaseLayout>

<style>
  .vservices {
    padding: 72px 0;
    background: var(--concrete);
    border-top: 1px solid var(--line);
  }
  /* The shared .featlist bullet is hardcoded to --pool in global.css; on a vertical page it
     must carry that vertical's identity colour instead. */
  .vservices .featlist li::before {
    background: var(--vt);
  }
  .area {
    margin-top: 30px;
    font-size: 12.5px;
    letter-spacing: 0.03em;
    color: var(--steel);
  }
  /* Designer Pools is the only vertical with a second photograph. It keeps the
     same 4:5 slot as the hero and stays lazy, so it does not compete with the
     hero for LCP. */
  .vservices-body.has-photo {
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    gap: 40px;
    align-items: start;
  }
  @media (max-width: 900px) {
    .vservices-body.has-photo { grid-template-columns: 1fr; gap: 26px; }
  }
  @media (max-width: 700px) {
    .vservices .featlist { grid-template-columns: 1fr; }
  }
</style>
