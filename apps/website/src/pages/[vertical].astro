---
/**
 * [vertical].astro — the four vertical landing pages: /pools, /coating, /renovation, /service.
 *
 * ONE template, four routes, generated from VERTICAL_LIST. This is deliberate: a hand-written
 * page per vertical is four places for the enum strings to drift (AC-2.4) and four places to
 * forget the attribution wiring. getStaticPaths over the single source of truth means adding a
 * fifth vertical to verticals.ts produces its page, its sitemap entry, and its schema for free —
 * and makes it impossible to ship a vertical with no landing page.
 *
 * Each page delivers:
 *  - a unique <title>, description, canonical, and OG set (AC-5.2)
 *  - exactly one <h1>, in VerticalHero (AC-5.3)
 *  - the service list for that vertical, reused from the existing content files
 *  - a visible FAQ, mirrored exactly by FAQPage JSON-LD
 *  - the quote form with the vertical PRE-SELECTED (AC-2.2) and still changeable (AC-2.3)
 *
 * The landing_page attribution for a visitor who arrives here is captured by BaseLayout's
 * first-touch script — that is what AC-1.5 asserts against `/pools`.
 */
import BaseLayout from '@layouts/BaseLayout.astro';
import Header from '@components/Header.astro';
import VerticalHero from '@components/VerticalHero.astro';
import Faq from '@components/Faq.astro';
import QuoteSection from '@components/QuoteSection.astro';
import Footer from '@components/Footer.astro';
import ImageSlot from '@components/ImageSlot.astro';

import { VERTICAL_LIST, type VerticalConfig } from '@content/verticals';
import { getVerticalPage, type VerticalPage } from '@content/vertical-pages';
import { pools } from '@content/pools';
import { serviceCards } from '@content/service-cards';
import {
  breadcrumbSchema,
  faqSchema,
  jsonLdGraph,
  serviceSchema,
} from '@lib/seo';

export function getStaticPaths() {
  const aliases: Record<string, string[]> = { pools:['pools','designer-pools'], coating:['coating','concrete-coating'], renovation:['renovation','design-and-renovation'], service:['service'] };
  return VERTICAL_LIST.flatMap((cfg) => (aliases[cfg.slug] ?? [cfg.slug]).map((slug) => ({ params:{ vertical:slug }, props:{ cfg, page:getVerticalPage(cfg.vertical) } })));
}

interface Props {
  cfg: VerticalConfig;
  page: VerticalPage;
}

const { cfg, page } = Astro.props;
const canonicalSlug: Record<string, string> = { pools:'designer-pools', coating:'concrete-coating', renovation:'design-and-renovation' };
const path = `/${canonicalSlug[cfg.slug] ?? cfg.slug}`;
const galleryIds = cfg.slug === 'pools' ? ['real-pool-work','real-pool-two','real-pool-three'] : cfg.slug === 'coating' ? ['real-coating-before','real-coating-work'] : cfg.slug === 'renovation' ? ['real-renovation-work','real-renovation-laundry','real-renovation-project'] : ['real-pool-work','real-pool-two'];
const projectSteps = ['First conversation','Understand the space','Explore design and options','Plan the work','Walkthrough'];
const customerQuote = cfg.slug === 'renovation' ? {quote:'They rescued me when 2 previous contractors failed to do the job. They found all the problems and poor quality work and made my house look and function beautifully. So easy and professional to work with. They get in, work quickly, and completely finish all the work they are hired to do. Kudos to Jorge and Frank for a job well done.',name:'Bonnie T.',role:'Home Owner'} : {quote:'Great work. Great people. Travis and his team do outstanding work. Highly recommend.',name:'Terry W.',role:'Home Owner'};

/**
 * The "what we do" list. Reused from the content the mockup already approved (D-08) rather
 * than rewritten: pools.ts for Designer Pools, service-cards.ts for the other three. If a
 * vertical ever has neither, that's a content gap and should fail the build, not render empty.
 */
const card = serviceCards.find((c) => c.vertical === cfg.vertical);
const features =
  cfg.vertical === pools.vertical ? pools.features : card?.services;
if (!features || features.length === 0) {
  throw new Error(`No service list found for vertical: ${cfg.vertical}`);
}

// The serv accent is too light for small text on white (AC-6.4) — same rule as the home page capability index (home/Capability.astro).
const textAccent = cfg.accentVar === '--serv' ? '--serv-text' : cfg.accentVar;

const jsonLd = jsonLdGraph([
  serviceSchema(cfg.vertical, page.seoDescription, path),
  faqSchema(page.faq, path),
  breadcrumbSchema(cfg.vertical, path),
]);
---
<BaseLayout
  title={page.seoTitle}
  description={page.seoDescription}
  path={path}
  jsonLd={jsonLd}
>
  <Header />
  <main id="content">
    <VerticalHero page={page} accentVar={cfg.accentVar} />

    <section class="vservices">
      <div class="wrap">
        <div class:list={['vservices-body', { 'has-photo': Boolean(page.secondaryImage) }]}>
          <div>
            <div class="sec-head">
              <p class="eyebrow" style={`color:var(${textAccent})`}>What we do</p>
              <h2>{card ? card.heading : pools.heading}</h2>
            </div>
            <ul class="featlist" style={`--vt:var(${cfg.accentVar})`}>
              {features.map((f) => <li>{f}</li>)}
            </ul>

            <p class="area mono">
              Serving customers in Lubbock, Texas.
            </p>
          </div>
          {page.secondaryImage && (
            <ImageSlot
              id={page.secondaryImage}
              class="vservices-photo"
              sizes="(max-width:900px) 100vw, 40vw"
            />
          )}
        </div>
      </div>
    </section>

    <Faq items={page.faq} accentVar={cfg.accentVar} />
    {cfg.slug === 'pools' && <section class="v-info"><div class="wrap"><p class="eyebrow">Planning a pool</p><h2>Start with the details that matter.</h2><p>Project planning can include questions about the property, applicable permits, and HOA approval. Requirements vary by project; use your first conversation to identify what needs to be confirmed.</p><div class="v-info-links"><a href="/service">Pool maintenance and service ↗</a><a href="https://www.lyonfinancial.net/dealer/apex-designer-pools-tx/" target="_blank" rel="noopener">Financing information from Lyon Financial ↗</a></div></div></section>}
    {cfg.slug === 'coating' && <section class="v-info"><div class="wrap"><p class="eyebrow">Surface, prep, finish</p><h2>Start with the condition of the concrete.</h2><p>Preparation, coating options, and care depend on the existing surface and selected system. Ask the Apex team to walk through those details and confirm any warranty terms that apply to your project.</p><div class="before-after"><figure><ImageSlot id="real-coating-before" sizes="(max-width:760px) 100vw, 45vw" /><figcaption>Before</figcaption></figure><figure><ImageSlot id="real-coating-work" sizes="(max-width:760px) 100vw, 45vw" /><figcaption>After</figcaption></figure></div></div></section>}
    {cfg.slug === 'renovation' && <section class="v-info"><div class="wrap"><p class="eyebrow">Plan your renovation</p><h2>Start with scope and priorities.</h2><p>Share the spaces you want to change, your priorities, and the budget you have in mind. Project scope and material choices shape the plan; the team can discuss next steps after learning more.</p></div></section>}
    <section class="v-gallery"><div class="wrap"><p class="eyebrow">Selected work</p><h2>Projects by Apex</h2><div class="v-gallery-grid">{galleryIds.map((id) => <ImageSlot id={id as any} sizes="(max-width:760px) 100vw, 33vw" />)}</div></div></section>
    <section class="v-process"><div class="wrap"><p class="eyebrow">The process</p><h2>Five clear steps.</h2><ol>{projectSteps.map((step,index)=><li><b>0{index+1}</b><span>{step}</span></li>)}</ol></div></section>
    <section class="v-review"><div class="wrap"><p class="eyebrow">Customer words</p><blockquote>“{customerQuote.quote}”</blockquote><p><b>{customerQuote.name}</b> · {customerQuote.role}</p></div></section>
    <QuoteSection
      preselect={cfg.vertical}
      heading={`Get your ${cfg.vertical.toLowerCase()} quote.`}
      lead={`Your service is already selected — add your details to send your request to the ${cfg.vertical} crew.`}
    />
  </main>
  <Footer />
</BaseLayout>

<style>
  .v-info,.v-gallery,.v-process,.v-review{padding:74px 0}.v-info{background:#fff}.v-info h2,.v-gallery h2,.v-process h2{font-size:clamp(38px,6vw,68px);max-width:850px}.v-info p:not(.eyebrow){max-width:800px}.v-info-links{display:flex;gap:24px;flex-wrap:wrap;margin-top:25px}.v-info-links a{text-decoration:underline;text-underline-offset:4px}.before-after,.v-gallery-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:18px;margin-top:30px}.before-after figure{margin:0;min-width:0}.before-after :global(.img-slot),.v-gallery-grid :global(.img-slot){width:100%;min-width:0}.before-after :global(picture),.v-gallery-grid :global(picture){display:block;width:100%;min-width:0}.before-after :global(img),.v-gallery-grid :global(img){display:block;width:100%;max-width:100%;height:340px;object-fit:cover}.before-after figcaption{margin-top:8px}.v-gallery{background:#efefec}.v-gallery-grid{grid-template-columns:repeat(3,1fr)}.v-process{background:#A1CCCA}.v-process .eyebrow{color:#383838}.v-process ol{list-style:none;padding:0;max-width:800px}.v-process li{display:flex;gap:24px;padding:18px 0;border-top:1px solid #667c7a}.v-process li b{font:14px Barlow,monospace}.v-process li span{font-size:20px}.v-review{background:#383838;color:white}.v-review blockquote{font-size:clamp(24px,3.4vw,42px);line-height:1.35;margin:20px 0;max-width:940px}.v-review .eyebrow{color:#A1CCCA}
  .vservices {
    padding: 72px 0;
    background: var(--concrete);
    border-top: 1px solid var(--line);
  }
  /* The shared .featlist bullet is hardcoded to --pool in global.css; on a vertical page it
     must carry that vertical's identity colour instead. */
  .vservices .featlist li::before {
    background: var(--vt);
  }
  .area {
    margin-top: 30px;
    font-size: 12.5px;
    letter-spacing: 0.03em;
    color: var(--steel);
  }
  /* Designer Pools is the only vertical with a second photograph. It keeps the
     same 4:5 slot as the hero and stays lazy, so it does not compete with the
     hero for LCP. */
  .vservices-body.has-photo {
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    gap: 40px;
    align-items: start;
  }
  @media (max-width: 900px) {
    .vservices-body.has-photo { grid-template-columns: 1fr; gap: 26px; }
  }
  @media (max-width: 700px) {
    .vservices .featlist { grid-template-columns: 1fr; }
    .v-gallery-grid,.before-after{grid-template-columns:1fr}.v-gallery-grid :global(img),.before-after :global(img){height:270px}
  }
</style>
