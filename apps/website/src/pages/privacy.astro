---
/**
 * /privacy — the privacy policy, transcribed verbatim (see content/legal.ts).
 *
 * This route exists because the live policy lives on the domain this project replaces and
 * would 404 at cutover, taking A2P 10DLC registration down with it: carriers gate SMS
 * campaigns on a reachable policy that names SMS, and the quote form captures SMS consent.
 *
 * Indexable on purpose. A privacy policy that carriers, browsers, and users are expected to
 * find should not be hidden from search.
 */
import BaseLayout from '@layouts/BaseLayout.astro';
import Header from '@components/Header.astro';
import Footer from '@components/Footer.astro';
import LegalDocument from '@components/LegalDocument.astro';
import { privacyPolicy } from '@content/legal';
import { breadcrumbSchema, jsonLdGraph } from '@lib/seo';

const path = '/privacy';
const jsonLd = jsonLdGraph([breadcrumbSchema('Privacy Policy', path)]);
---
<BaseLayout
  title="Privacy Policy | Apex — Lubbock, TX"
  description="How Apex collects, uses, and protects your personal information, including SMS messaging and your right to deletion."
  path={path}
  jsonLd={jsonLd}
>
  <Header />
  <main id="top">
    <LegalDocument doc={privacyPolicy} />
  </main>
  <Footer />
</BaseLayout>
