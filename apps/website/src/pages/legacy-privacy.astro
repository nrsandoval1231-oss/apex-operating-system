---
import BaseLayout from '@layouts/BaseLayout.astro';
import Header from '@components/Header.astro';
import Footer from '@components/Footer.astro';
import LegalDocument from '@components/LegalDocument.astro';
import { privacyPolicy } from '@content/legal';
---
<BaseLayout title="Earlier Privacy Policy | Apex" description="Earlier Apex privacy policy retained for reference." path="/legacy-privacy">
  <Header /><main id="content"><LegalDocument doc={privacyPolicy} /><p class="wrap"><a href="/privacy">View the current privacy policy</a></p></main><Footer />
</BaseLayout>

