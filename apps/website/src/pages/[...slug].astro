---
import BaseLayout from '@layouts/BaseLayout.astro';
import Header from '@components/Header.astro';
import Footer from '@components/Footer.astro';
import QuoteSection from '@components/QuoteSection.astro';
import ImageSlot from '@components/ImageSlot.astro';
import { testimonials } from '@content/testimonials';

export function getStaticPaths() {
const pages = [
  { slug:'about-apex', title:'About Apex', intro:'Apex brings specialty and general construction services together for customers in Lubbock, Texas.', image:'owner-portrait', detail:'Built from West Texas roots and a commitment to serve customers well.' },
  { slug:'work', title:'Our Work', intro:'A look at pool, concrete coating, and renovation projects from Apex.', image:'real-pool-work', detail:'Explore the projects and services that connect our three divisions.' },
  { slug:'contact', title:'Contact Apex', intro:'Tell our team what you are planning in Lubbock, Texas.', image:'real-renovation-work', detail:'Call 806-605-0502 or use the project request form below. Include the project type, location, and what you hope to change so the team has useful context for the conversation.' },
  { slug:'process', title:'Our Process', intro:'A clear conversation is the first step toward a well-planned project.', image:'real-pool-work', detail:'Share the project, talk through the details, and plan a path forward with our team.' },
  { slug:'service-areas', title:'Service Area', intro:'Apex serves customers in Lubbock, Texas.', image:'real-coating-work', detail:'The published service area for this website is Lubbock, Texas. Include the project address or neighborhood in your request so the team can confirm whether it fits the work you have in mind.' },
];
return pages.map((page) => ({ params:{ slug:page.slug }, props:{ page } }));
}
const { page } = Astro.props;
const vertical = undefined;
---
<BaseLayout title={`${page.title} | Apex Lubbock, TX`} description={page.intro} path={`/${page.slug}`}>
  <Header />
  <main id="content">
    <section class="landing-hero"><div class="landing-image"><ImageSlot id={page.image as any} sizes="(max-width:760px) 100vw, 55vw" /></div><div class="wrap landing-copy"><p class="eyebrow">Apex · Lubbock, Texas</p><h1>{page.title}</h1><p>{page.intro}</p><a class="btn" href="#quote">Get a free quote ↗</a></div></section>
    <section class="landing-detail wrap"><p class="eyebrow">Anything Construction. Apex Gets It Done.</p><h2>{page.detail}</h2>{page.slug==='about-apex'&&<div class="about-story"><p>Founder and CEO Travis Bouffard was born and raised in West Texas. He joined the Lubbock Fire Department in 2011, then founded Southern Legacy Custom Homes in 2016. He retired from the fire department in 2022 and launched Apex Concrete Coating.</p><p>In 2023, Travis founded Apex Designer Pools and Apex Design & Renovation. His goal is to build a leading general contracting business in Lubbock and provide a strong experience for each customer.</p><p>Travis and his wife Jenna have five children. His oldest son serves in the United States Air Force, and his four younger children attend Lubbock Cooper. He enjoys golf when he is not working or spending time with family.</p></div>}</section>
    {page.slug==='about-apex'&&<section class="all-testimonials"><div class="wrap"><p class="eyebrow">From Apex customers</p><h2>Customer words.</h2><div class="all-testimonial-grid">{testimonials.map((item)=><figure><blockquote>“{item.quote}”</blockquote><figcaption><b>{item.name}</b><span>{item.context}</span></figcaption></figure>)}</div></div></section>}
    {page.slug==='work'&&<section class="work-section"><div class="wrap"><p class="eyebrow">Project gallery</p><h2>Selected work</h2><div class="work-filters" role="group" aria-label="Filter projects"><button data-filter="all" aria-pressed="true">All work</button><button data-filter="pool" aria-pressed="false">Pools</button><button data-filter="coating" aria-pressed="false">Coating</button><button data-filter="renovation" aria-pressed="false">Renovation</button></div><div class="landing-projects filtered-projects"><a data-kind="pool" href="/designer-pools"><ImageSlot id="real-pool-work" sizes="(max-width:760px) 100vw, 33vw"/><span>Designer Pools</span></a><a data-kind="pool" href="/designer-pools"><ImageSlot id="real-pool-two" sizes="(max-width:760px) 100vw, 33vw"/><span>Designer Pools</span></a><a data-kind="coating" href="/concrete-coating"><ImageSlot id="real-coating-work" sizes="(max-width:760px) 100vw, 33vw"/><span>Concrete Coating</span></a><a data-kind="coating" href="/concrete-coating"><ImageSlot id="real-coating-before" sizes="(max-width:760px) 100vw, 33vw"/><span>Concrete Coating</span></a><a data-kind="renovation" href="/design-and-renovation"><ImageSlot id="real-renovation-work" sizes="(max-width:760px) 100vw, 33vw"/><span>Design & Renovation</span></a><a data-kind="renovation" href="/design-and-renovation"><ImageSlot id="real-renovation-laundry" sizes="(max-width:760px) 100vw, 33vw"/><span>Design & Renovation</span></a></div></div></section>}
    {page.slug==='process'&&<section class="landing-process"><div class="wrap"><p class="eyebrow">A clear way forward</p><h2>Five steps to get the work moving.</h2><ol><li>First conversation — share your idea and priorities.</li><li>Understand the space — talk through the project details.</li><li>Explore design and options — consider what fits your goals.</li><li>Plan the work — agree on scope and next steps.</li><li>Walkthrough — review the completed work together.</li></ol></div></section>}
    {vertical && <section class="division-links"><div class="wrap"><h2>Explore the Apex divisions</h2><nav aria-label="Apex divisions"><a href="/designer-pools">Designer Pools</a><a href="/concrete-coating">Concrete Coating</a><a href="/design-and-renovation">Design & Renovation</a><a href="/service">Pool Maintenance</a></nav></div></section>}
    <QuoteSection preselect={vertical as any} heading={vertical ? `Tell us about your ${page.title.toLowerCase()} project.` : `Get your project started.`} lead={page.intro} />
  </main><Footer />
</BaseLayout>
<script>
  const filterButtons=[...document.querySelectorAll<HTMLButtonElement>('[data-filter]')];
  filterButtons.forEach((button)=>button.addEventListener('click',()=>{filterButtons.forEach((b)=>{b.setAttribute('aria-pressed',String(b===button));b.classList.toggle('active',b===button)});document.querySelectorAll<HTMLElement>('.filtered-projects [data-kind]').forEach((card)=>{card.hidden=button.dataset.filter!=='all'&&card.dataset.kind!==button.dataset.filter})}));
</script>
<style>
  .landing-hero{display:grid;grid-template-columns:1fr 1fr;background:#383838;color:white;min-height:620px}.landing-image{min-height:460px}.landing-image :global(img){width:100%;height:100%;object-fit:cover}.landing-copy{align-self:center;padding-top:70px;padding-bottom:70px}.landing-copy h1{font-size:clamp(52px,7vw,90px);line-height:.95}.landing-copy>p:not(.eyebrow){max-width:480px;font-size:19px;margin:24px 0 30px;color:#eee}.landing-detail{padding-top:90px;padding-bottom:90px}.about-story{max-width:850px;font-size:19px;line-height:1.7}.landing-detail h2,.landing-process h2{font-size:clamp(34px,5vw,60px);max-width:850px}.landing-process{padding:76px 0;background:#A1CCCA}.landing-process ol{padding-left:22px;max-width:800px}.landing-process li{padding:9px}.all-testimonials{padding:70px 0;background:#383838;color:#fff}.all-testimonials .eyebrow{color:#A1CCCA}.all-testimonials h2{font-size:clamp(38px,6vw,68px)}.all-testimonial-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:24px;margin-top:28px}.all-testimonial-grid figure{margin:0;padding:20px;border-top:1px solid #777}.all-testimonial-grid blockquote{margin:0 0 14px}.all-testimonial-grid figcaption{display:flex;flex-direction:column}.all-testimonial-grid figcaption span{color:#c6c6c6;font-size:13px}.landing-copy .eyebrow{color:#A1CCCA}.landing-process .eyebrow{color:#383838}.landing-projects{display:grid;grid-template-columns:repeat(3,1fr);gap:18px;margin-top:28px}.landing-projects>a{position:relative;min-height:240px;overflow:hidden;color:#fff}.landing-projects :global(img){display:block;width:100%;height:260px;object-fit:cover}.landing-projects span{position:absolute;bottom:12px;left:12px;font-size:18px;background:#383838;padding:8px 11px;border-radius:2px;text-shadow:none}.division-links{background:#fff;padding:45px 0}.division-links nav{display:flex;flex-wrap:wrap;gap:24px;margin-top:15px}.division-links a{text-decoration:underline}@media(max-width:760px){.landing-hero{grid-template-columns:1fr}.landing-image{min-height:300px;max-height:360px}.landing-copy{padding-top:36px;padding-bottom:60px}.landing-detail{padding-top:60px;padding-bottom:60px}.landing-process{padding:58px 0}.all-testimonial-grid{grid-template-columns:1fr}.landing-projects{grid-template-columns:1fr}.landing-projects :global(img){height:260px}}
</style>
