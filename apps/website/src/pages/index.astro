---
import BaseLayout from '@layouts/BaseLayout.astro';
import Header from '@components/Header.astro';
import QuoteSection from '@components/QuoteSection.astro';
import Footer from '@components/Footer.astro';
import ImageSlot from '@components/ImageSlot.astro';
import { testimonials } from '@content/testimonials';
import { jsonLdGraph, organizationSchema, websiteSchema } from '@lib/seo';
import { site } from '@lib/site';

const title = 'Apex | Anything Construction. Apex Gets It Done. | Lubbock, TX';
const description = 'Apex brings designer pools, concrete coating, and design and renovation together in Lubbock, Texas. See the work and tell us what you have in mind.';
const jsonLd = jsonLdGraph([organizationSchema(), websiteSchema()]);
const divisions = [
  { title: 'Designer Pools', href: '/designer-pools', legacy: '/pools', vertical: 'Designer Pools', image: 'real-pool-work', label: 'Pool design and construction', description: 'Custom pools, spas, and outdoor living.' },
  { title: 'Concrete Coating', href: '/concrete-coating', legacy: '/coating', vertical: 'Concrete Coating', image: 'real-coating-work', label: 'Concrete coating for homes and businesses', description: 'Garage, patio, pool deck, shop, and commercial surfaces.' },
  { title: 'Design & Renovation', href: '/design-and-renovation', legacy: '/renovation', vertical: 'Design & Renovation', image: 'real-renovation-work', label: 'Home design and renovation', description: 'Residential and commercial renovation projects.' },
];
const reviews = testimonials.slice(0, 3);
---
<BaseLayout title={title} description={description} path="/" jsonLd={jsonLd}>
  <Header />
  <main id="content">
    <section class="home-hero">
      <div class="home-hero-image"><ImageSlot id="home-night-pool-hero" sizes="(max-width:760px) 100vw, 62vw" loading="eager" /></div>
      <div class="home-hero-shade"></div>
      <div class="wrap home-hero-copy">
        <p class="eyebrow">Lubbock, Texas · Pools &amp; outdoor living</p>
        <h1>Their favorite memories<br /><em>start at home.</em></h1>
        <p>Summer afternoons. One more swim before bedtime. A backyard that brings everyone together.</p>
        <div class="hero-actions"><a class="btn" href="/designer-pools">Explore designer pools <span aria-hidden="true">↗</span></a><a class="text-link" href={`tel:${site.phoneE164}`} aria-label={`Call Apex at ${site.phoneDisplay}`}>Call Apex</a></div>
      </div>
      <span class="hero-index mono">From the Apex pool gallery</span>
    </section>

    <section class="home-intro wrap"><p class="eyebrow">Your Lubbock project team</p><div><h2>Clear communication.<br />Craft in every detail.</h2><p>Local team. Thoughtful planning. Workmanship with pride. Whatever you’re building, our crew will help make the next step clear.</p></div></section>
    <section class="trust-strip" aria-label="The Apex approach"><span>Locally based in Lubbock</span><span>Clear communication</span><span>Pride in every detail</span></section>
    <span id="services" class="anchor-alias" aria-hidden="true"></span>
    <section id="divisions" class="division-list" aria-label="Apex divisions">
      {divisions.map((item, i) => <a class="division-card" href={item.href} data-preselect={item.vertical}>
        <div class="division-photo"><ImageSlot id={item.image as any} sizes="(max-width:760px) 100vw, 65vw" /></div>
        <div class="division-meta"><span class="mono">0{i + 1} / DIVISION</span><span aria-hidden="true">↗</span></div>
        <h2>{item.title}</h2><p class="division-description">{item.description}</p><span class="division-cta">Explore the work</span>
      </a>)}
    </section>

    <section class="work-section" id="work"><div class="wrap">
      <div class="section-heading"><p class="eyebrow">Selected work</p><h2>Made here.<br /><em>Made to last.</em></h2><p>Real projects from the Apex team. Browse by the kind of work you have in mind.</p></div>
      <div class="work-filters" role="group" aria-label="Filter projects"><button class="active" data-filter="all" aria-pressed="true">All work</button><button data-filter="pool" aria-pressed="false">Pools</button><button data-filter="coating" aria-pressed="false">Coating</button><button data-filter="renovation" aria-pressed="false">Renovation</button></div>
      <div class="work-grid">
        <a href="/designer-pools" class="work-item wide" data-kind="pool"><ImageSlot id="real-pool-work" sizes="(max-width:760px) 100vw, 65vw" /><span>Designer Pools <b>↗</b></span></a>
        <a href="/concrete-coating" class="work-item" data-kind="coating"><ImageSlot id="real-coating-work" sizes="(max-width:760px) 100vw, 40vw" /><span>Concrete Coating <b>↗</b></span></a>
        <a href="/design-and-renovation" class="work-item" data-kind="renovation"><ImageSlot id="real-renovation-work" sizes="(max-width:760px) 100vw, 40vw" /><span>Design & Renovation <b>↗</b></span></a>
        <a href="/designer-pools" class="work-item" data-kind="pool"><ImageSlot id="real-pool-two" sizes="(max-width:760px) 100vw, 40vw" /><span>Pool Design <b>↗</b></span></a>
        <a href="/concrete-coating" class="work-item" data-kind="coating"><ImageSlot id="real-coating-before" sizes="(max-width:760px) 100vw, 40vw" /><span>Concrete Project <b>↗</b></span></a>
        <a href="/design-and-renovation" class="work-item" data-kind="renovation"><ImageSlot id="real-renovation-laundry" sizes="(max-width:760px) 100vw, 40vw" /><span>Renovation <b>↗</b></span></a>
      </div>
    </div></section>

    <section class="recent-work wrap" aria-labelledby="recent-heading"><div class="section-heading"><p class="eyebrow">Recent projects</p><h2 id="recent-heading">A closer look<br /><em>at the details.</em></h2><p>Explore more pool, coating, and renovation work.</p></div><div class="recent-grid"><a href="/designer-pools"><ImageSlot id="real-pool-three" sizes="(max-width:760px) 90vw, 30vw" /><span>Pool design</span></a><a href="/concrete-coating"><ImageSlot id="real-coating-before" sizes="(max-width:760px) 90vw, 30vw" /><span>Concrete coating</span></a><a href="/design-and-renovation"><ImageSlot id="real-renovation-laundry" sizes="(max-width:760px) 90vw, 30vw" /><span>Design &amp; renovation</span></a></div><a class="text-link" href="/work">View all project categories ↗</a></section>
    <section class="process-section"><div class="wrap process-layout"><div><p class="eyebrow">A clear way forward</p><h2>Good work starts<br />with a good conversation.</h2><p>Every project is different. We’ll listen, learn what matters to you, and talk through the next step together.</p><a class="btn" href="#quote">Start a conversation ↗</a></div><ol><li><b>01</b><div><h3>First conversation</h3><p>Tell us what you have in mind and what matters most.</p></div></li><li><b>02</b><div><h3>Understand the space</h3><p>We’ll learn more about the project and what you need.</p></div></li><li><b>03</b><div><h3>Explore the design</h3><p>Talk through ideas, priorities, and project details.</p></div></li><li><b>04</b><div><h3>Plan the work</h3><p>Discuss the next steps for your project.</p></div></li><li><b>05</b><div><h3>Walkthrough</h3><p>Review the completed work together.</p></div></li></ol></div></section>

    <section class="testimonial-section" id="testimonials"><div class="wrap"><div class="section-heading"><p class="eyebrow">From our customers</p><h2>Good people.<br /><em>Good work.</em></h2></div><div class="review-grid">{reviews.map((r) => <figure><blockquote>“{r.quote}”</blockquote><figcaption><b>{r.name}</b><span>{r.context}</span></figcaption></figure>)}</div></div></section>
    <section class="final-cta"><div class="wrap"><p class="eyebrow">Ready when you are</p><h2>LET’S GET YOUR<br /><em>PROJECT STARTED.</em></h2><a class="btn" href="#quote">GET A FREE QUOTE ↗</a><a class="final-phone" href="tel:+18066050502">Or call 806-605-0502</a></div></section>
    <QuoteSection />
    <section class="service-area"><div class="wrap"><p class="eyebrow">Rooted in Lubbock</p><h2>Built for our<br />corner of Texas.</h2><p>Apex serves customers in Lubbock, Texas. Have a project in mind? Let’s talk about it.</p><a href="/service-areas">Service area details ↗</a></div></section>
  </main>
  <Footer />
</BaseLayout>
<script>
  const filters = [...document.querySelectorAll<HTMLButtonElement>('[data-filter]')];
  const items = [...document.querySelectorAll<HTMLElement>('.work-item')];
  filters.forEach((button) => button.addEventListener('click', () => {
    filters.forEach((b) => { b.classList.toggle('active', b === button); b.setAttribute('aria-pressed', String(b === button)); });
    items.forEach((item) => { item.hidden = button.dataset.filter !== 'all' && item.dataset.kind !== button.dataset.filter; });
  }));
</script>
<style>
  .home-hero{position:relative;min-height:min(760px,calc(100svh - 64px));display:flex;align-items:flex-end;overflow:hidden;background:#383838;color:#fff}.home-hero-image,.home-hero-shade{position:absolute;inset:0}.home-hero-image :global(.img-slot){height:100%;border:0;border-radius:0}.home-hero-image :global(img){width:100%;height:100%;object-fit:cover}.home-hero-shade{background:linear-gradient(90deg,rgba(20,22,22,.78),rgba(20,22,22,.12)),linear-gradient(0deg,rgba(20,22,22,.52),transparent 70%)}.home-hero-copy{position:relative;padding-top:140px;padding-bottom:108px;max-width:1180px}.home-hero h1{font-size:clamp(52px,8.4vw,112px);max-width:960px;line-height:.95;letter-spacing:-.025em}.home-hero h1 em,.section-heading h2 em{color:#A1CCCA;font-style:normal}.home-hero-copy>p:not(.eyebrow){max-width:540px;font-size:19px;color:#f1f1f1;margin:26px 0}.hero-actions{display:flex;align-items:center;gap:26px}.text-link{color:#fff;text-decoration:underline;text-underline-offset:5px}.hero-index{position:absolute;right:4vw;bottom:34px;color:#fff;font-size:11px;letter-spacing:.1em}.home-intro{display:grid;grid-template-columns:.8fr 1.2fr;gap:5vw;padding-top:100px;padding-bottom:76px}.home-intro h2,.section-heading h2,.process-section h2,.service-area h2{font-size:clamp(42px,6vw,76px);line-height:.98}.home-intro p:not(.eyebrow),.section-heading>p:last-child,.process-layout>div>p:not(.eyebrow),.service-area .wrap>p:not(.eyebrow){max-width:480px;color:#555;margin-top:20px}.division-list{display:grid;grid-template-columns:repeat(3,1fr);gap:1px;background:#fff;padding:0 2.5vw 92px}.division-card{background:#383838;color:#fff;padding:14px 14px 32px;transition:background .2s}.division-card:hover{background:#303433}.division-photo{height:clamp(220px,36vw,490px);overflow:hidden}.division-photo :global(img){width:100%;height:100%;object-fit:cover;transition:transform .5s}.division-card:hover .division-photo :global(img){transform:scale(1.025)}.division-meta{display:flex;justify-content:space-between;color:#A1CCCA;font-size:11px;margin:22px 4px 10px}.division-card h2{font-size:clamp(26px,3.2vw,42px)}.division-cta{display:block;margin-top:14px;text-decoration:underline;text-underline-offset:4px}.work-section{background:#efefec;padding:100px 0}.section-heading{display:grid;grid-template-columns:.8fr 1.2fr;align-items:end;gap:32px;margin-bottom:32px}.section-heading .eyebrow{grid-column:1/-1;margin:0 0 -16px}.section-heading>p:last-child{margin:0 0 5px}.work-filters{display:flex;gap:8px;flex-wrap:wrap;margin:24px 0}.work-filters button{background:transparent;border:1px solid #999;border-radius:30px;padding:9px 18px;color:#383838;cursor:pointer}.work-filters button.active{background:#383838;color:white;border-color:#383838}.work-grid{display:grid;grid-template-columns:1.4fr 1fr;gap:18px}.work-item{position:relative;min-height:270px;overflow:hidden;color:#fff;background:#383838}.work-item.wide{grid-row:span 2}.work-item :global(img){width:100%;height:100%;min-height:270px;object-fit:cover;position:absolute;inset:0;transition:transform .4s}.work-item:hover :global(img){transform:scale(1.025)}.work-item:after{content:'';position:absolute;inset:45% 0 0;background:linear-gradient(transparent,rgba(0,0,0,.68))}.work-item span{position:absolute;z-index:1;bottom:18px;left:22px;right:22px;font-size:22px}.work-item span b{float:right}.process-section{padding:110px 0;background:#A1CCCA}.process-layout{display:grid;grid-template-columns:1fr 1fr;gap:9vw;align-items:center}.process-layout>div>p:not(.eyebrow){margin-bottom:24px}.process-layout ol{padding:0;margin:0;list-style:none}.process-layout li{display:grid;grid-template-columns:50px 1fr;gap:18px;border-top:1px solid rgba(56,56,56,.35);padding:22px 0}.process-layout li>b{font:14px Barlow,monospace}.process-layout h3{font:600 23px Barlow,sans-serif;text-transform:none}.process-layout li p{margin:5px 0 0;color:#343b3b}.testimonial-section{padding:100px 0;background:#383838;color:white}.testimonial-section .section-heading h2{color:white}.review-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:34px}.review-grid figure{margin:0;border-top:1px solid #777;padding-top:22px}.review-grid blockquote{font-size:19px;line-height:1.5;margin:0 0 28px}.review-grid figcaption{display:grid;gap:2px}.review-grid figcaption span{color:#c6c6c6;font-size:14px}.service-area{padding:88px 0;background:#fff}.service-area a{display:inline-block;margin-top:12px;text-decoration:underline;text-underline-offset:4px;color:#383838}
  .trust-strip{display:flex;justify-content:space-around;gap:18px;padding:20px 4vw;background:#fff;border-block:1px solid #e5e5e5;color:#383838;font:12px Barlow,sans-serif;text-transform:uppercase;letter-spacing:.07em}.final-cta{background:#383838;color:#fff;padding:100px 0}.final-cta h2{font-size:clamp(52px,8vw,100px);line-height:.95;margin-bottom:30px}.final-cta h2 em{font-style:normal;color:#A1CCCA}.final-cta .eyebrow{color:#A1CCCA}
  .sticky-mobile{display:none}
  .division-description{max-width:32ch;margin:8px 0 14px;color:#ddd;font-size:16px}.recent-work{padding-top:70px;padding-bottom:76px}.recent-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:18px;margin:24px 0}.recent-grid>a{position:relative;display:block;min-height:200px;color:#fff}.recent-grid :global(img){display:block;width:100%;height:230px;object-fit:cover}.recent-grid span{position:absolute;left:14px;bottom:14px;background:#383838;padding:8px 11px;border-radius:2px;text-shadow:none;font-weight:700}.final-phone{display:inline-block;margin:12px 0 0 18px;color:#fff;text-decoration:underline;text-underline-offset:4px}
  :global(#work .section-heading h2 em),:global(#recent-heading em){color:#383838}.process-section .eyebrow,.process-section .process-layout>div>p:not(.eyebrow){color:#383838}.testimonial-section .eyebrow{color:#A1CCCA}
  .anchor-alias{display:block;position:relative;top:-70px;visibility:hidden}
  @media(max-width:760px){.recent-grid{grid-template-columns:1fr}.final-phone{display:block;margin:18px 0}.home-hero{min-height:680px;min-height:calc(88svh - 60px)}.home-hero-copy{padding-bottom:100px}.home-hero-copy>p:not(.eyebrow){font-size:17px}.home-intro,.section-heading,.process-layout{grid-template-columns:1fr}.home-intro{padding-top:68px;gap:8px}.division-list{grid-template-columns:1fr;padding:0 14px 60px;gap:10px}.division-photo{height:300px}.work-section,.testimonial-section,.process-section{padding:70px 0}.work-grid{grid-template-columns:1fr}.work-item.wide{grid-row:auto}.work-item{min-height:260px}.review-grid{grid-template-columns:1fr;gap:28px}.hero-actions{align-items:flex-start;flex-direction:column;gap:16px}.section-heading{gap:10px}.section-heading .eyebrow{margin:0}.trust-strip{flex-direction:column;align-items:center;text-align:center}.final-cta{padding:76px 0}.sticky-mobile{display:grid;grid-template-columns:1fr 1.2fr;position:fixed;z-index:60;bottom:0;left:0;right:0;padding:8px 12px calc(8px + env(safe-area-inset-bottom));background:#383838;gap:9px}.sticky-mobile a{text-align:center;padding:12px 6px;color:#fff;border:1px solid #A1CCCA;font:16px 'Bebas Neue',sans-serif;text-transform:uppercase}.sticky-mobile a:last-child{background:#A1CCCA;color:#222}body:has(.home-hero){padding-bottom:calc(64px + env(safe-area-inset-bottom))}}
  /* Homepage-only evening composition; the rest of the site retains its brand system. */
  .home-hero{min-height:min(800px,calc(100svh - 70px));align-items:center;background:#14201f}
  .home-hero-image{left:38%}.home-hero-image :global(img){object-position:50% 72%}
  .home-hero-shade{background:linear-gradient(90deg,#14201f 25%,rgba(20,32,31,.96) 37%,rgba(20,32,31,.24) 57%,transparent 73%),linear-gradient(0deg,rgba(8,15,15,.55),transparent 22%)}
  .home-hero-copy{flex:none;width:calc(100% - 120px);max-width:1180px;margin-inline:auto;padding:92px 0 106px}
  .home-hero .eyebrow{max-width:350px;color:#a1ccca;font-size:11px;letter-spacing:.17em;line-height:1.7;margin:0 0 32px}
  .home-hero h1{font-family:Barlow,sans-serif;font-weight:400;font-size:clamp(64px,6.7vw,100px);line-height:1.02;letter-spacing:-.045em;max-width:610px;margin:0 0 30px;text-transform:none}
  .home-hero h1 em{color:#a1ccca;font-style:normal;font-weight:400}
  .home-hero-copy>p:not(.eyebrow){max-width:350px;font-size:18px;line-height:1.65;color:#e7ebe8;margin:0 0 34px}
  .home-hero .hero-actions{display:flex;flex-direction:row;flex-wrap:wrap;align-items:center;gap:24px}
  .home-hero .hero-actions .btn{background:#a1ccca;color:#14201f;min-height:48px;padding:15px 21px;font-family:Barlow,sans-serif;font-size:13px;font-weight:600;letter-spacing:.025em;text-transform:none}
  .home-hero .hero-actions .text-link{color:#fff;font:500 14px Barlow,sans-serif;min-height:48px;display:inline-flex;align-items:center;text-transform:none;text-underline-offset:5px}
  .home-hero .hero-index{bottom:27px;right:4vw;color:#e7ebe8;font-size:10px;letter-spacing:.12em}
  @media(min-width:761px) and (max-width:1050px){.home-hero-copy{width:calc(100% - 72px)}.home-hero h1{font-size:72px;max-width:480px}.home-hero-image{left:32%}.home-hero-shade{background:linear-gradient(90deg,#14201f 18%,rgba(20,32,31,.93) 33%,transparent 78%)}}
  @media(max-width:760px){.home-hero{min-height:0;display:block}.home-hero-image{left:0;bottom:auto;height:58%}.home-hero-image :global(img){object-position:50% 71%}.home-hero-shade{background:linear-gradient(0deg,#14201f 0%,#14201f 34%,rgba(20,32,31,.76) 47%,transparent 68%)}.home-hero-copy{width:calc(100% - 44px);padding:270px 0 68px}.home-hero .eyebrow{max-width:280px;font-size:10px;letter-spacing:.13em;margin-bottom:18px}.home-hero h1{font-size:clamp(48px,14vw,76px);line-height:1.04;letter-spacing:-.04em;margin-bottom:22px}.home-hero-copy>p:not(.eyebrow){font-size:16px;line-height:1.6;max-width:310px;margin-bottom:25px}.home-hero .hero-actions{gap:17px}.home-hero .hero-actions .btn{padding:14px 16px}.home-hero .hero-index{font-size:9px;right:22px;bottom:23px}}
  </style>
