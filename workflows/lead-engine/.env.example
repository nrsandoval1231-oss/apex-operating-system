# Apex Lead Engine (n8n) — environment / credential reference
# Copy to `.env` and fill. NEVER commit `.env`.
# In n8n itself, prefer stored Credentials over env vars for anything secret.
# This file is the checklist of what must exist before each phase can run.

# ---- n8n instance (required) ----
# Set the real instance URL locally. Do not commit a live host.
N8N_BASE_URL=https://n8n.example.invalid
N8N_API_KEY=

# Webhook paths the website POSTs to (must match apex-website PUBLIC_LEAD_WEBHOOK_URL)
WEBHOOK_PATH_LEAD_INTAKE=apex-lead-intake
WEBHOOK_PATH_LEAD_INTAKE_TEST=apex-lead-intake-test

# Environment gate. Hard rule 6: non-production never sends to real people
# and never fires real conversions.
ENGINE_ENV=development

# ---- Holding store — Phase 1 (required) ----
# Interim CRM until D-10 resolves. Airtable or Google Sheets.
# Built so the destination swaps in one node (D-19).
HOLDING_STORE=airtable
AIRTABLE_API_KEY=
AIRTABLE_BASE_ID=
AIRTABLE_TABLE_LEADS=Leads
AIRTABLE_TABLE_QUARANTINE=Quarantine
# Job-status events (D-12 signal, workflows/02-job-status.ts). One row per transition.
AIRTABLE_TABLE_JOB_EVENTS=JobEvents

# ---- SMS — Phase 2 (BLOCKED on D-11) ----
# Twilio recommended. US business texting requires A2P 10DLC registration —
# start this early, approval is slow and it gates the whole SMS branch.
SMS_PROVIDER=twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_TEST_TO_NUMBER=          # sandbox destination for non-production runs

# ---- Email — Phase 2 (required) ----
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=noreply@apexgetsitdone.com

# ---- Team routing — Phase 2 (BLOCKED on D-13) ----
# Confirm these are real monitored mailboxes before wiring sends.
INBOX_POOLS=pools@apexgetsitdone.com
INBOX_COATING=coating@apexgetsitdone.com
INBOX_RENOVATION=reno@apexgetsitdone.com
INBOX_SERVICE=service@apexgetsitdone.com
SLACK_WEBHOOK_URL=              # optional secondary notification channel

# ---- SLA / monitoring — Phase 6 ----
SLA_RESPONSE_MINUTES=5
ALERT_EMAIL=
ALERT_SLACK_WEBHOOK_URL=

# ---- Quiet hours — Phase 2 (BLOCKED on D-14) ----
# TCPA restricts marketing texts to roughly 8am–9pm local.
# Do not hardcode a policy until the maintainer confirms.
QUIET_HOURS_ENABLED=true
QUIET_HOURS_START=08:00
QUIET_HOURS_END=21:00
QUIET_HOURS_TZ=America/Chicago

# ---- CRM — Phase 3 (BLOCKED on D-10) ----
CRM_PROVIDER=
CRM_API_KEY=
CRM_BASE_URL=

# ---- Meta offline conversions — Phase 5 (BLOCKED on D-01 + D-12) ----
META_ACCESS_TOKEN=
META_PIXEL_ID=
META_DATASET_ID=
META_TEST_EVENT_CODE=           # required for non-production; keeps test events out of live optimization
