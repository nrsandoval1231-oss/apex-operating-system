---
/**
 * ImageSlot.astro — the ONLY way images render on the site (D-20 / AC-9).
 *
 * Given a slot id from the image manifest (content/images.ts), it renders EITHER the real
 * photo (once `src` is filled) OR a visibly-labeled placeholder — always inside a box with
 * the slot's fixed aspect ratio, so swapping a real photo in causes zero layout shift
 * (AC-9.1). Alt text and sources come from the manifest, never from the calling component
 * (AC-9.2, AC-9.3). Placeholders are never silently blank (AC-9.4).
 */
import { getImageSlot, type ImageSlotId } from '@content/images';

interface Props {
  id: ImageSlotId;
  /** Extra class on the wrapper (e.g. to fill a tile). */
  class?: string;
  /** `sizes` attribute for responsive srcset once a real photo is set (AC-9.5). */
  sizes?: string;
  /** Eager-load above-the-fold images; defaults to lazy (AC-9.5). */
  loading?: 'lazy' | 'eager';
}

const { id, class: className, sizes, loading = 'lazy' } = Astro.props;
const slot = getImageSlot(id);

// Decorative images render empty alt; meaningful images use the manifest alt (AC-9.2).
const altText = slot.decorative ? '' : slot.alt;
const wrapperClass = ['img-slot', className].filter(Boolean).join(' ');
const style = `aspect-ratio:${slot.ratio};`;
---
{slot.src ? (
  <div class={wrapperClass} style={style}>
    {/*
      `data-stock` marks a licensed stand-in rather than real Apex work (D-20). It is
      intentionally an attribute and NOT a visible badge: this build gets shown to the client,
      and a watermark across every photo would read as unfinished rather than as honest. The
      guard is `npm run preflight`, which counts these and warns before any launch — see the
      note on `stock` in content/images.ts.
    */}
    <img
      src={slot.src}
      srcset={slot.srcset}
      sizes={sizes}
      alt={altText}
      loading={loading}
      decoding="async"
      data-stock={slot.stock ? 'true' : undefined}
    />
  </div>
) : (
  <div
    class={wrapperClass}
    style={style}
    role={slot.decorative ? 'presentation' : 'img'}
    aria-label={slot.decorative ? undefined : slot.alt}
    data-image-slot={slot.id}
    data-image-unfilled="true"
  >
    {/* The empty-slot placeholder carried a large watermark of the old placeholder lion.
        That mark was never Apex's real identity, so it is removed rather than swapped: the
        real logo is a solid sage panel and would read as a coloured block here, not a
        watermark. The texture and the visible label still make the slot obviously
        intentional rather than broken (AC-9.4). */}
    <div class="img-ph" aria-hidden="true">
      <span class={`img-ph-tex tone-${slot.tone}`}></span>
      <span class="lbl mono">{slot.label}</span>
    </div>
  </div>
)}
