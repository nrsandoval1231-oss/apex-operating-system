---
/**
 * Owner.astro — founder section. Content from content/owner.ts. CTA anchors to the quote
 * section (no vertical preselect — it's a general "free quote").
 */
import { owner } from '@content/owner';
import ImageSlot from './ImageSlot.astro';
---
<section id="owner">
  <div class="wrap owner-grid">
    <ImageSlot id={owner.image} sizes="(max-width:820px) 100vw, 40vw" />
    <div>
      <p class="eyebrow">{owner.eyebrow}</p>
      <h2>{owner.name}<br /><span class="owner-sub">{owner.title}</span></h2>
      <p class="lead" style="margin-top:16px">{owner.bio}</p>
      <div style="margin-top:22px">
        <a class="btn ghost" href="#quote" style="color:var(--ink);border-color:var(--line)">{owner.cta}</a>
      </div>
    </div>
  </div>
</section>
