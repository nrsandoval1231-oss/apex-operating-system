---
/**
 * VerticalHero.astro — the top of a vertical landing page (/pools, /coating, ...).
 *
 * Carries the page's single <h1> (AC-5.3) and is colour-coded to the vertical's accent token,
 * so an ad click lands on a page that visibly belongs to the service that was advertised.
 * Content is passed in from content/vertical-pages.ts — nothing is inlined here (D-07/D-08).
 *
 * A breadcrumb back to the home router sits above the H1: a visitor who landed here from a
 * paid click has never seen the four-vertical router, and it is the only thing that recovers
 * them if they picked the wrong service.
 */
import type { VerticalPage } from '@content/vertical-pages';
import ImageSlot from './ImageSlot.astro';

interface Props {
  page: VerticalPage;
  /** Accent CSS variable for the vertical, e.g. "--pool". */
  accentVar: string;
}

const { page, accentVar } = Astro.props;
---
<section class="vhero" id="top" style={`--vt:var(${accentVar})`}>
  <div class="wrap vhero-in">
    <div class="vhero-copy">
      <nav class="crumb mono" aria-label="Breadcrumb">
        <a href="/">Apex</a> <span aria-hidden="true">/</span> <span>{page.vertical}</span>
      </nav>
      <p class="eyebrow vhero-eyebrow">{page.eyebrow}</p>
      <h1>{page.h1}</h1>
      <p class="vhero-lead">{page.lead}</p>

      <div class="hero-stats">
        {page.proof.map((s) => (
          <div class="hstat"><b>{s.value}</b><span>{s.label}</span></div>
        ))}
      </div>

      <div class="vhero-cta">
        <a class="btn" href="#quote" data-preselect={page.vertical}>{page.cta} &rarr;</a>
      </div>
    </div>

    <div class="vhero-media">
      <ImageSlot id={page.image} loading="eager" sizes="(max-width:900px) 100vw, 45vw" />
    </div>
  </div>
</section>

<style>
  .vhero {
    background: var(--char);
    color: #f4f2ee;
    /* The vertical's identity colour as a top rule — the fastest "you're in the right place". */
    border-top: 4px solid var(--vt);
    padding: 56px 0 64px;
  }
  .vhero-in {
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: 48px;
    align-items: center;
  }
  .crumb {
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #9e968b;
    margin-bottom: 18px;
  }
  .crumb a:hover { color: var(--amber); }
  .crumb span[aria-hidden] { margin: 0 6px; }

  /* Eyebrow sits on charcoal here, so the deep-bronze light-bg variant would fail AA.
     Use the vertical's own accent, which is the identity signal anyway. */
  .vhero-eyebrow { color: var(--vt); }

  .vhero h1 {
    font-size: clamp(34px, 5.4vw, 60px);
    margin-top: 12px;
    max-width: 16ch;
  }
  .vhero-lead {
    font-size: 19px;
    color: #c8c2b8;
    max-width: 56ch;
    margin-top: 18px;
  }
  .vhero-cta { margin-top: 30px; }

  .vhero-media :global(.img-slot) {
    border-radius: var(--r);
    overflow: hidden;
    box-shadow: var(--shadow);
  }

  @media (max-width: 900px) {
    .vhero-in { grid-template-columns: 1fr; gap: 32px; }
    /* Copy first on mobile — the maintainer and the client both open this on a phone. */
    .vhero-media { order: 2; }
    .vhero-copy { order: 1; }
    .vhero h1 { max-width: none; }
  }
</style>
