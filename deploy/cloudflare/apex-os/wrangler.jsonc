{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "apex-os-staging",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-02",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "containers": [
    {
      "class_name": "ApexOsContainer",
      "image": "../../../Dockerfile",
      "max_instances": 1,
      "instance_type": "basic"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "APEX_OS",
        "class_name": "ApexOsContainer"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["ApexOsContainer"]
    }
  ],
  "vars": {
    "S3_BUCKET": "apex-evidence-staging",
    "S3_REGION": "auto",
    "APEX_ACCESS_TEAM": "REPLACE_WITH_ACCESS_TEAM",
    "APEX_ACCESS_AUD": "REPLACE_WITH_ACCESS_AUD",
    // Legacy fallback for the one app_users row that has no email yet.
    // Delete both keys after that row's email column is set. Do not commit a real address.
    "APEX_ACCESS_EMAIL": "REPLACE_WITH_NICK_GMAIL",
    "APEX_ACCESS_USER_ID": "REPLACE_WITH_USER_ULID"
  }
}
